{
  "name": "kidsland",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w @kidsland/server\" \"npm run dev -w @kidsland/client\"",
    "dev:server": "npm run dev -w @kidsland/server",
    "dev:client": "npm run dev -w @kidsland/client",
    "build": "npm run build -w @kidsland/server && npm run build -w @kidsland/client",
    "test": "npm test -w @kidsland/shared && npm test -w @kidsland/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "msedge-tts": "^2.1.0"
  }
}
